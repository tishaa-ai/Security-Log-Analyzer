# Runtime data (local SQLite database and generated reports)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
# Ignore generated output, but keep sample reports
output/*
!output/.gitkeep
!output/sample_alerts_report.csv
!output/sample_alerts_report.json
!output/sample_incident_report.pdf

# Editors / OS
.vscode/
.idea/
Thumbs.db
